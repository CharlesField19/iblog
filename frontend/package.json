{
  "name": "iblog-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:admin",
    "format": "prettier --write \"{admin,web}/src/**/*.{js,vue}\" \"shared/*.js\" \"{admin,web}/src/styles/reconstruction.css\" \"{admin,web}/index.html\"",
    "format:check": "prettier --check \"{admin,web}/src/**/*.{js,vue}\" \"shared/*.js\" \"{admin,web}/src/styles/reconstruction.css\" \"{admin,web}/index.html\"",
    "test:i18n": "node --test shared/i18n.test.js shared/publicData.test.js",
    "build:web": "vite build --config web/vite.config.js",
    "build:admin": "vite build --config admin/vite.config.js",
    "dev:web": "vite --config web/vite.config.js",
    "dev:admin": "vite --config admin/vite.config.js"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "vue": "3.5.44",
    "vue-i18n": "11.4.18",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.6.2",
    "vite": "7.3.7"
  }
}

{
  "name": "iblog-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:admin",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"{admin,web}/src/**/*.{ts,vue}\" \"shared/*.{ts,css}\" \"{admin,web}/src/styles/*.css\" \"{admin,web}/index.html\" \"*.json\"",
    "format:check": "prettier --check \"{admin,web}/src/**/*.{ts,vue}\" \"shared/*.{ts,css}\" \"{admin,web}/src/styles/*.css\" \"{admin,web}/index.html\" \"*.json\"",
    "test:i18n": "tsx --test shared/*.test.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:admin": "vite --config admin/vite.config.ts"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-i18n": "11.4.18",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "7.3.7",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
